{
  "name": "papa-vendor",
  "private": true,
  "version": "0.0.0",
  "description": "Inventory and operations for film equipment rental houses",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build:tokens",
    "build:tokens": "npm run build -w @papa/tokens",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test \"packages/*/test/**/*.test.mjs\" \"apps/*/test/**/*.test.mjs\"",
    "test:sql": "./supabase/run-tests.sh",
    "test:all": "npm run typecheck && npm test && npm run test:sql"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "typescript": "^5.6.3"
  }
}
