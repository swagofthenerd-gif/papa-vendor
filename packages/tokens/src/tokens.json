{
  "$schema": "./tokens.schema.json",
  "$meta": {
    "name": "@papa/tokens",
    "description": "Primitive design tokens shared by Papa Rentals and Papa Vendor. PRIMITIVES ONLY — no semantic tokens. See README.",
    "source": "Extracted verbatim from papa-rentals/src/styles.css :root (lines 9-67) and :root[data-theme='dark'] (lines 75-97).",
    "themes": ["light", "dark"],
    "note": "Papa Vendor adds a third 'sun' theme, but that is an APP-OWNED semantic layer, not a shared primitive. Do not add it here."
  },

  "color": {
    "accent":       { "light": "#ff6b2c", "dark": "#ff7b40", "comment": "2.9:1 on white — fails AA as text. Safe on fills at 700 weight in large sizes only. Apps needing accent-as-text define their own darker alias." },
    "accent-dark":  { "light": "#e5551a", "dark": "#ff9563" },
    "accent-soft":  { "light": "#fff1e8", "dark": "#3a2417" },
    "ink":          { "light": "#222222", "dark": "#f2efec" },
    "muted":        { "light": "#6f6a63", "dark": "#a8a29e" },
    "line":         { "light": "#ece7e0", "dark": "#37322d" },
    "line-strong":  { "light": "#ddd6cc", "dark": "#4a443c" },
    "bg":           { "light": "#fdfbf8", "dark": "#161310" },
    "card":         { "light": "#ffffff", "dark": "#211d18" },
    "card-2":       { "light": "#f6f3ee", "dark": "#2b2620" },

    "green":        { "light": "#16a34a", "dark": "#34d074" },
    "green-soft":   { "light": "#eafcf1", "dark": "#12301d" },
    "green-ink":    { "light": "#15803d", "dark": "#5fe094", "comment": "Exists because --green on --green-soft is only 3.09:1, below AA at badge text sizes. This reaches 4.7:1 on the same tint. Dark is the inverse problem: light ink on a dark tint. Do not delete this token to 'simplify' the palette." },

    "purple":       { "light": "#7c3aed", "dark": "#a78bfa" },
    "purple-soft":  { "light": "#f3ecfe", "dark": "#2a2140" },
    "red":          { "light": "#dc2626", "dark": "#f87171" },
    "red-soft":     { "light": "#fdecec", "dark": "#3a1a1a" },
    "star":         "#f59e0b",
    "star-off":     { "light": "#d6d3d1", "dark": "#4a443e" }
  },

  "radius": {
    "r-sm":   "12px",
    "r-md":   "16px",
    "r-lg":   "20px",
    "r-xl":   "28px",
    "r-pill": "999px"
  },

  "shadow": {
    "shadow-xs": {
      "light": "0 1px 2px rgba(34, 30, 24, 0.05)",
      "dark":  "0 1px 2px rgba(0, 0, 0, 0.3)"
    },
    "shadow-sm": {
      "light": "0 1px 2px rgba(34, 30, 24, 0.06), 0 2px 8px rgba(34, 30, 24, 0.05)",
      "dark":  "0 1px 3px rgba(0, 0, 0, 0.4), 0 4px 16px rgba(0, 0, 0, 0.3)"
    },
    "shadow-md": {
      "light": "0 2px 4px rgba(34, 30, 24, 0.05), 0 6px 16px rgba(34, 30, 24, 0.08)",
      "dark":  "0 2px 4px rgba(0, 0, 0, 0.4), 0 6px 20px rgba(0, 0, 0, 0.4)"
    },
    "shadow-lg": {
      "light": "0 6px 12px rgba(34, 30, 24, 0.08), 0 16px 40px rgba(34, 30, 24, 0.14)",
      "dark":  "0 6px 12px rgba(0, 0, 0, 0.45), 0 16px 44px rgba(0, 0, 0, 0.5)"
    }
  },

  "fontSize": {
    "fs-xs":   "11px",
    "fs-sm":   "12.5px",
    "fs-base": "14px",
    "fs-md":   "16px",
    "fs-lg":   "19px",
    "fs-xl":   "22px",
    "fs-2xl":  "27px"
  },

  "space": {
    "sp-1": "4px",
    "sp-2": "8px",
    "sp-3": "12px",
    "sp-4": "16px",
    "sp-5": "20px",
    "sp-6": "24px",
    "sp-8": "32px"
  },

  "motion": {
    "ease-out":    "cubic-bezier(0.16, 1, 0.3, 1)",
    "ease-spring": "cubic-bezier(0.34, 1.56, 0.64, 1)",
    "dur-fast":    "0.15s",
    "dur":         "0.25s",
    "dur-slow":    "0.45s"
  },

  "size": {
    "tap": "44px"
  },

  "font": {
    "ff-sans": "'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
  },

  "alias": {
    "radius": "var(--r-md)",
    "shadow": "var(--shadow-sm)"
  }
}
